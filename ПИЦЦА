def load_orders():
    if not os.path.exists(ORDERS_FILE):
        return {}
    try:
        with open(ORDERS_FILE, "r", encoding = "utf-8") as f:
            return json.load(f)
    except (json.JSONDecodeError, I0Error):
        return {}

def save_orders(order):
    orders = load_orders()
    orders.append(order)
    with open(ORDERS_FILE, "w", encoding = "utf-8") as f:
        json.dump(orders, f, ensure_ascii = False, indent = 2)

def get_age():
    while True:
        try:
            age_client = int(input("Укажите возраст клиента: "))
            if age_client < 0:
                print("Некорректный возраст!")
                continue
            return age_client
        except ValueError:
            print("Некорректное число!")

def show_menu(age_client):
    if age_client < 10:
        print("     Детское меню:")
        current_menu = Kids_menu
    else:
        print("     Пиццы:")
        current_menu = Pizza_menu
    print()
    for num, (name, price) in current_menu.items():
        print(f"{num}: {name} - {price}")
    return current_menu

def get_position(menu):
    total = 0
    position = {}
    while True:
        try:
            choice = int(input("Введите номер выбранной позиции. Если завершили заказ, нажмите 0: "))
        except ValueError:
            print("Некорректный выбор!")
            continue

        if choice == 0:
            break
        if choice in menu:
            name, price = menu[choice]
            total = total + price
            position.append({"Позиции": name, "Сумма заказа": price})
            print(f"Добавлено: {name} за {price}р . Текущая сумма: {total}")
        else:
            print("Такой позиции нет в меню!")
    return position, total

def pay(total):
    if total == 0:
        print("Сначала сделайте заказ!")
        return
    print(f"Итоговыя сумма к оплате: {total}р")
    while True:
        pay_method = input("Чем будите оплачивать? (Наличными/Картой): ")
        if pay_method == "Картой":
            print("Оплата принята!")
            return "Картой", None
        elif pay_method == "Наличными":
            while True:
                try:
                    cash_give = float(input("Введите сумму которой вы хотите оплатить заказ: "))
                    if cash_give < total:
                        print("Недостаточно средств!")
                        continue
                    change = cash_give - total
                    print("Принято!")
                    print(f"Ваша сдача: {change}р")
                    return "Наличными", change
                except ValueError:
                    print("Некорректная сумма!")
        else:
            print("Некорректный способ оплаты!")

