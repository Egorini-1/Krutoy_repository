    1: ("Пицца Маргарита", 599),
    2: ("Пицца Пепперони", 649),
    3: ("Пицца Четыре сыра", 879),
    4: ("Пицца Гавайская", 899),
    5: ("Пицца Грибная", 679),
    6: ("Пицца Мясная", 849),
    7: ("Evervess кола 1л", 109),
    8: ("Картофель фри 200г", 129),
}

Kids_menu = {
    1: ("Мороженое", 149),
    2: ("Коктейль", 179),
    3: ("Мини Пицца Пепперони", 399),
    4: ("Мини Пицца Сырная", 349),
    5: ("Evervess кола 500мл", 69),
    6: ("Картофель фри 125г", 79)
}

def get_age():
    while True:
        try:
            age_client = int(input("Укажите возраст клиента: "))
            if age_client < 0:
                print("Некорректный возраст!")
                continue
            return age_client
        except ValueError:
            print("Некорректное число!")

def show_menu(age_client):
    if age_client < 10:
        print("     Детское меню:")
        current_menu = Kids_menu
    else:
        print("     Взрослое меню:")
        current_menu = Adult_menu
    print()
    for num, (name, price) in current_menu.items():
        print(f"{num}: {name} - {price}")
    return current_menu

def get_position(menu):
    total = 0
    position = []
    while True:
        try:
            choice = int(input("Введите номер выбранной позиции. Если завершили заказ, нажмите 0: "))
        except ValueError:
            print("Некорректный выбор!")
            continue

        if choice == 0:
            break
        if choice in menu:
            name, price = menu[choice]
            total = total + price
            position.append({"Позиция": name, "Сумма заказа": price})
            print(f"Добавлено: {name} за {price}р . Текущая сумма: {total}")
        else:
            print("Такой позиции нет в меню!")
    return position, total

def pay(total):
    if total == 0:
        print("Сначала сделайте заказ!")
        return
    print(f"Итоговыя сумма к оплате: {total}р")
    while True:
        pay_method = input("Чем будите оплачивать? (Наличными/Картой): ")
        if pay_method == "Картой":
            print("Оплата принята!")
            return "Картой", None
        elif pay_method == "Наличными":
            while True:
                try:
                    cash_give = float(input("Введите сумму которой вы хотите оплатить заказ: "))
                    if cash_give < total:
                        print("Недостаточно средств!")
                        continue
                    change = cash_give - total
                    print("Принято!")
                    print(f"Ваша сдача: {change}р")
                    break
                except ValueError:
                    print("Некорректная сумма!")
        else:
            print("Некорректный способ оплаты!")
            continue

try:
    while True:
        quantity_clients = int(input("Сколько человек в заказе?: "))
        try:
            if quantity_clients <= 0:
                print("Некорректное кол-во человек в заказе!")
                continue
            break
        except ValueError:
            print("Введите целое положительное число!")

    all_total = 0
    for i in range(quantity_clients):
        print(f"   Клиент №{i + 1}")
        age_client = get_age()
        current_menu = menu(age_client)
        order_sum = get_position(current_menu)
        all_total += order_sum

    print()
    pay(all_total)
    print("Спасибо за заказ! Приходите еще!")

except ValueError:
    print("Введено некорректное число для кол-ва гостей!")
